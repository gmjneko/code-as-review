# Committed defaults. Put machine-specific overrides in .env.local (git-ignored).

# Base path of the backend API as seen by the browser. Keep it same-origin in production
# (reverse proxy or Spring Boot serving the bundle) so no CORS setup is needed.
VITE_API_BASE_URL=/api

# Dev server only: where `pnpm dev` proxies /api requests. Not exposed to the client bundle.
CONSOLE_API_PROXY_TARGET=http://localhost:8080
